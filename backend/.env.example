# Backend Environment Variables (DO NOT COMMIT REAL SECRETS)
APP_ENV=development
APP_NAME="CareLens AI"
API_VERSION=0.1.0
DEBUG=True

# Server Host & Port
HOST=127.0.0.1
PORT=8000

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

